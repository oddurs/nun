* text=auto eol=lf

*.rs      text diff=rust
*.toml    text
*.md      text
*.sh      text eol=lf
scripts/* text eol=lf
.githooks/* text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary

CHANGELOG.md merge=union

# ROADMAP.md is generated from the items. On a merge, re-derive it rather than
# trying to reconcile two renderings of different inputs.
ROADMAP.md merge=cairn

# An item is the source rather than a rendering, so it cannot be re-derived.
# The driver unions its sequence fields, where two branches both meant what
# they added, and leaves everything else to a person.
cairn/items/*.md merge=cairn

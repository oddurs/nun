#!/bin/sh
# The single seam between this project and all automation.
#
# CI, the git hooks and scripts/agent know only these target names. Everything
# stack-specific lives here and nowhere else, so the two can never drift.
set -eu

# Where this checkout builds. The primary checkout uses its own `target/`; a
# linked worktree gets a directory of its own inside it, at
# `target/worktrees/<type>-<slug>`, so every build lands wherever the primary's
# `target/` lives (it may be a link to another volume) and the worktrees' builds
# are not left behind in their checkouts to fill a disk.
#
# Each worktree needs its own directory, not a share of one. Cargo names a
# workspace crate's artifacts from its path relative to the workspace root, which
# is the same in every worktree, and decides freshness by mtime, so a shared
# directory can link one branch against another branch's build of a crate — a
# green check of the wrong code. An explicit CARGO_TARGET_DIR still wins.
target_dir() {
    _common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    _primary=$(dirname "$_common")
    _top=$(git rev-parse --show-toplevel)
    if [ "$_top" = "$_primary" ]; then
        printf '%s/target' "$_primary"
    else
        printf '%s/target/worktrees/%s-%s' "$_primary" \
            "$(basename "$(dirname "$_top")")" "$(basename "$_top")"
    fi
}

if [ -z "${CARGO_TARGET_DIR:-}" ] && _dir=$(target_dir); then
    CARGO_TARGET_DIR=$_dir
    export CARGO_TARGET_DIR
fi

usage() {
    cat <<'USAGE'
Usage: scripts/task <target>

Targets:
  fmt        Format the tree in place
  fmt:check  Verify formatting; non-zero on drift
  lint       Clippy with warnings denied
  test       Full test suite
  build      Compile the workspace
  check      fmt:check && lint && test && build
  install    Build in release and put this working copy on your PATH
  target:dir Print the directory this checkout builds into
USAGE
}

case "${1:-}" in
    fmt)
        cargo fmt --all
        ;;
    target:dir)
        printf '%s\n' "${CARGO_TARGET_DIR:-target}"
        ;;
    fmt:check)
        cargo fmt --all -- --check
        ;;
    lint)
        cargo clippy --workspace --all-targets --all-features -- -D warnings
        ;;
    test)
        cargo test --workspace --all-targets --all-features
        ;;
    build)
        cargo build --workspace --all-features
        ;;
    install)
        # Release, because the debug build is slow enough to feel on a large
        # repository — which is exactly what you install it to try it on.
        cargo install --path crates/nun --locked --force
        ;;
    check)
        "$0" fmt:check
        "$0" lint
        "$0" test
        "$0" build
        ;;
    -h | --help | help | "")
        usage
        ;;
    *)
        printf 'task: unknown target `%s`\n\n' "$1" >&2
        usage >&2
        exit 1
        ;;
esac
